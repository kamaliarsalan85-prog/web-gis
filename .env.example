# ==========================================
# Backend-Only Configuration & Secrets
# NEVER expose these in VITE_* variables or frontend code
# ==========================================
PORT=3000
DATABASE_URL=
DATABASE_SSL=
DATABASE_POOL_MAX=
DATABASE_CONNECTION_TIMEOUT_MS=
DATABASE_IDLE_TIMEOUT_MS=
JWT_SECRET=
CORS_ORIGIN=
CACHE_TTL_MS=
EXTERNAL_API_BASE=
ENABLE_TMP_REGISTER=false

# ==========================================
# Frontend Public Configuration (Vite)
# Safe to expose in browser bundle
# ==========================================
VITE_API_BASE_URL=
VITE_SOCKET_URL=

# ==========================================
# GitHub Pages Build Configuration
# Used by vite.config.js during production build
# ==========================================
GITHUB_REPOSITORY_NAME=